llColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2410" y="62" width="90" height="24" as="geometry" /></mxCell><mxCell id="public-daily" value="&lt;b&gt;DAILY  ·  MM SOURCE RECORDS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monarch API — Multiple Myeloma associations&lt;br&gt;DisMech — pinned Multiple Myeloma YAML&lt;br&gt;Fetched by the internet-connected pipeline Lambda" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#F0F8ED;strokeColor=#1D8102;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#23313D;" vertex="1" parent="1"><mxGeometry as="geometry" x="2770" y="270" width="520" height="165" /></mxCell><mxCell id="public-manual" value="&lt;b&gt;MANUAL  ·  BASE RECORDS + DRUG TARGETS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monarch + DisMech — MM and JMML&lt;br&gt;Open Targets — targets of named drug agents&lt;br&gt;Python fetchers → raw files → explicit S3 upload" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#EDF6FC;strokeColor=#2473A6;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#23313D;" vertex="1" parent="1"><mxGeometry as="geometry" x="2770" y="535" width="520" height="180" /></mxCell><mxCell id="public-trials" value="&lt;b&gt;MANUAL  ·  REGISTERED CLINICAL TRIALS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read staged DisMech treatment PMIDs from S3&lt;br&gt;PubMed structured accessions → exact NCT IDs&lt;br&gt;Fetch those records from ClinicalTrials.gov&lt;br&gt;Archive registry JSON, PubMed XML and provenance" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#F4EFFA;strokeColor=#7850A8;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#23313D;" vertex="1" parent="1"><mxGeometry as="geometry" x="2770" y="795" width="520" height="205" /></mxCell><mxCell id="manual-control" value="&lt;b&gt;EXPLICIT MANUAL LOAD&lt;/b&gt;&lt;br&gt;&lt;br&gt;Upload sources, then invoke kg-ingest&lt;br&gt;clinical_trials: true loads the registry snapshot" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#FFFFFF;strokeColor=#687787;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#23313D;" vertex="1" parent="1"><mxGeometry as="geometry" x="2770" y="1130" width="520" height="120" /></mxCell><mxCell id="s3-provenance-note" value="&lt;b&gt;SOURCE SNAPSHOTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Original records + IDs&lt;br&gt;Source versions + dates&lt;br&gt;SHA-256 checksums&lt;br&gt;Daily: manifest + result.json&lt;br&gt;Trials: immutable archive" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#F0F8ED;strokeColor=#1D8102;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#23313D;" vertex="1" parent="1"><mxGeometry as="geometry" x="1360" y="770" width="240" height="240" /></mxCell><mxCell id="validation-note" value="&lt;b&gt;VALIDATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Daily: atomic upsert + count checks&lt;br&gt;Read back source versions and counts&lt;br&gt;Manual validators compare evidence&lt;br&gt;and trial metadata with S3 snapshots" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#F0F8ED;strokeColor=#1D8102;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#23313D;" vertex="1" parent="1"><mxGeometry as="geometry" x="2250" y="600" width="360" height="200" /></mxCell><mxCell id="upsert-note" value="&lt;b&gt;GRAPH WRITE SEMANTICS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Small, parameterized openCypher MERGE&lt;br&gt;Stable IDs preserve the existing graph&lt;br&gt;Source-specific evidence and provenance&lt;br&gt;Upsert only; no automatic deletions" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fillColor=#F0F8ED;strokeColor=#1D8102;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#23313D;" vertex="1" parent="1"><mxGeometry as="geometry" x="2250" y="845" width="360" height="190" /></mxCell><mxCell id="manual-ingest-note" value="MM / JMML + trial metadata" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#244137;fontStyle=0;spacing=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1835" y="918" width="180" height="28" /></mxCell><mxCell id="daily-ingest-note" value="Atomic upsert + validate" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#244137;fontStyle=0;spacing=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="2040" y="918" width="180" height="28" /></mxCell><mxCell id="manual-nightly-note" value="Manual refresh: clinical trials + Open Targets.&lt;br&gt;Daily refresh: MM Monarch + DisMech." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#244137;fontStyle=0;spacing=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="2250" y="1045" width="360" height="44" /></mxCell><mxCell id="ingestion-footer" value="Solid arrows: data / reads     Dashed arrows: invocation     •     Private S3 and Neptune in us-west-2     •     Direct Lambda invocation; no Step Functions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#415567;fontStyle=0;spacing=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="1360" width="3020" height="42" /></mxCell><mxCell id="e-daily-public-fetch" value="Monarch + pinned DisMech" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D8102;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="public-daily" target="tile-pipeline-fetch"><mxGeometry as="