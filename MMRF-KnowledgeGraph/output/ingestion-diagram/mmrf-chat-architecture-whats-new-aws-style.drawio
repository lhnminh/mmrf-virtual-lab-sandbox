as="geometry" /></mxCell><mxCell id="e-ingest-neptune-label" value="upsert" style="html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#FFFFFF;fontSize=13;fontFamily=Arial;fontColor=#232F3E;shadow=0;" connectable="0" vertex="1" parent="e-ingest-neptune"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="-24" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="public-daily" value="&lt;b&gt;Daily public sources&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monarch API — Multiple Myeloma associations&lt;br&gt;DisMech — pinned Multiple Myeloma YAML" style="rounded=0;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#7B8794;strokeWidth=1;fontFamily=Arial;fontSize=17;fontColor=#232F3E;shadow=0;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="2770" y="270" width="520" height="165" /></mxCell><mxCell id="public-manual" value="&lt;b&gt;Manual source collection&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monarch + DisMech — MM and JMML&lt;br&gt;Open Targets — drug-to-gene targets&lt;br&gt;Python scripts → raw files → S3 upload" style="rounded=0;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#7B8794;strokeWidth=1;fontFamily=Arial;fontSize=17;fontColor=#232F3E;shadow=0;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="2770" y="535" width="520" height="180" /></mxCell><mxCell id="public-trials" value="&lt;b&gt;Clinical-trial enrichment — manual&lt;/b&gt;&lt;br&gt;&lt;br&gt;DisMech treatment citations&lt;br&gt;PubMed structured accessions → NCT IDs&lt;br&gt;ClinicalTrials.gov registry records&lt;br&gt;Archive source JSON, PubMed XML and hashes" style="rounded=0;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#7B8794;strokeWidth=1;fontFamily=Arial;fontSize=17;fontColor=#232F3E;shadow=0;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="2770" y="795" width="520" height="205" /></mxCell><mxCell id="manual-control" value="&lt;b&gt;Manual execution&lt;/b&gt;&lt;br&gt;&lt;br&gt;Upload sources, then invoke kg-ingest&lt;br&gt;clinical_trials: true adds registry records" style="rounded=0;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#7B8794;strokeWidth=1;fontFamily=Arial;fontSize=17;fontColor=#232F3E;shadow=0;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="2770" y="1130" width="520" height="120" /></mxCell><mxCell id="ingestion-footer" value="Solid lines: data and queries     Dashed lines: invocation     |     us-west-2     |     Daily: MM Monarch + DisMech     |     Trials and Open Targets: manual refresh" style="html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#566573;fontStyle=0;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="1360" width="3020" height="42" /></mxCell><mxCell id="e-daily-public-fetch" value="public records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=open;endFill=0;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=1;fontColor=#232F3E;shadow=0;" edge="1" parent="1" source="public-daily" target="tile-pipeline-fetch"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2705" y="352" /><mxPoint x="2705" y="1325" /><mxPoint x="1700" y="1325" /></Array></mxGeometry></mxCell><mxCell id="e-manual-public-s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=open;endFill=0;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.33;fontColor=#232F3E;shadow=0;" edge="1" parent="1" source="public-manual" target="tile-kg-s3"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2688" y="625" /><mxPoint x="2688" y="1120" /><mxPoint x="180