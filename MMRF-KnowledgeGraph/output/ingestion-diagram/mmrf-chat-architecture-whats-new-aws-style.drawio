ex="1" parent="1"><mxGeometry as="geometry" x="1725" y="1028" width="40" height="40" /></mxCell><mxCell id="flow-step-4" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1920" y="1170" width="40" height="40" /></mxCell><mxCell id="flow-step-5" value="5" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="2135" y="965" width="40" height="40" /></mxCell><mxCell id="flow-step-6" value="6" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1950" y="715" width="40" height="40" /></mxCell><mxCell id="flow-step-7" value="7" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="2750" y="745" width="40" height="40" /></mxCell><mxCell id="flow-step-8" value="8" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1940" y="490" width="40" height="40" /></mxCell><mxCell id="flow-key-title" value="Ingestion flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=25;fontStyle=1;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="1440" width="1200" height="38" /></mxCell><mxCell id="flow-key-1" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="1500" width="38" height="38" /></mxCell><mxCell id="flow-key-text-1" value="&lt;b&gt;Schedule.&lt;/b&gt; EventBridge Scheduler starts the MM fetch Lambda daily at 02:00 UTC." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="276" y="1500" width="1400" height="66" /></mxCell><mxCell id="flow-key-2" value="2" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="1582" width="38" height="38" /></mxCell><mxCell id="flow-key-text-2" value="&lt;b&gt;Collect.&lt;/b&gt; Fetch bounded Monarch records and the pinned DisMech Multiple Myeloma YAML." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="276" y="1582" width="1400" height="66" /></mxCell><mxCell id="flow-key-3" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="1664" width="38" height="38" /></mxCell><mxCell id="flow-key-text-3" value="&lt;b&gt;Stage.&lt;/b&gt; Store original responses, versions and SHA-256 hashes in private S3; commit the manifest last." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="276" y="1664" width="1400" height="66" /></mxCell><mxCell id="flow-key-4" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="1746" width="38" height="38" /></mxCell><mxCell id="flow-key-text-4" value="&lt;b&gt;Invoke.&lt;/b&gt; The fetch Lambda directly invokes private ingestion with the snapshot manifest receipt." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="276" y="1746" width="1400" height="66" /></mxCell><mxCell id="flow-key-5" value="5" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1750" y="1500" width="38" height="38" /></mxCell><mxCell id="flow-key-text-5" value="&lt;b&gt;Verify.&lt;/b&gt; Read S3 through the gateway endpoint and verify the selected snapshot before writing." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1806" y="1500" width="1400" height="66" /></mxCell><mxCell id="flow-key-6" value="6" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1750" y="1582" width="38" height="38" /></mxCell><mxCell id="flow-key-text-6" value="&lt;b&gt;Load and validate.&lt;/b&gt; Use parameterized openCypher MERGE; daily refreshes validate counts in the transaction and read back." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1806" y="1582" width="1400" height="66" /></mxCell><mxCell id="flow-key-7" value="7" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1750" y="1664" width="38" height="38" /></mxCell><mxCell id="flow-key-text-7" value="&lt;b&gt;Enrich manually.&lt;/b&gt; Stage MM/JMML, drug targets and registry snapshots; explicitly invoke the core ingest Lambda." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1806" y="1664" width="1400" height="66" /></mxCell><mxCell id="flow-key-8" value="8" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1750" y="1746" width="38" height="38" /></mxCell><mxCell id="flow-key-text-8" value="&lt;b&gt;Query and inspect.&lt;/b&gt; Read-only Lambda serves AgentCore and the graph API; validators compare evidence and registry fields with S3." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1806" y="1746" width="1400" height="66" /></mxCell><mxCell id="scope-note" value="Small incremental upserts into the existing graph. Trial enrollment and status are source-reported registry metadata; no patient-level records are included." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="1836" width="3040" height="42" /></mxCell></root></mxGraphModel></diagram></mxfile>