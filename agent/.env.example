# Copy to agent/.env and fill in values for your AWS account and region.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# For a Bedrock API key, uncomment this line and paste the key locally.
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# Alternatively use AWS_PROFILE and an AWS CLI/SSO profile instead of a key.
# AWS_PROFILE=your-profile

# Virtual Lab gateway used for survival data (default: the local stack).
# VIRTUAL_LAB_ORIGIN=http://127.0.0.1:3080

# Set this to use a separate Correlation Plot service instead of the built-in
# survival executor.
# CORRELATION_TOOL_URL=http://127.0.0.1:9000/correlation
