{
  "name": "mmrf-virtual-lab-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "prompt": "node --env-file-if-exists=.env src/cli.mjs",
    "smoke:bedrock": "node --env-file-if-exists=.env src/cli.mjs --mock-tool --require-tool",
    "tools": "node src/catalog-cli.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/credential-provider-node": "3.972.92",
    "@modelcontextprotocol/client": "2.4.0",
    "@smithy/signature-v4": "5.7.5",
    "@strands-agents/sdk": "1.23.0"
  }
}
