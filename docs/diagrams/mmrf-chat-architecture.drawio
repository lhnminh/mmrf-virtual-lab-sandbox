mxCell id="e-ingest-neptune-label" value="load" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e-ingest-neptune"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="-24" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="legend-bg" value="" style="html=1;fillColor=light-dark(#EDF3FF,#305363);fillStyle=auto;strokeColor=#6c8ebf;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2705" y="26" width="650" height="1284" as="geometry"/></mxCell><mxCell id="step-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="196" y="394" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="412" y="394" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="648" y="394" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="852" y="394" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1040" y="230" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1496" y="490" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1566" y="394" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1786" y="394" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-9" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1936" y="480" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-10" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="146" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-11" value="11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1006" y="490" width="28" height="28" as="geometry"/></mxCell><mxCell id="step-12" value="12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1576" y="1204" width="28" height="28" as="geometry"/></mxCell><mxCell id="legend-title" value="How a question is answered" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2725" y="44" width="600" height="30" as="geometry"/></mxCell><mxCell id="step-1-badge-legend" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2725" y="88" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-1-desc-legend" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Ask in Chat&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;The researcher's browser sends the question over HTTPS, as an AG-UI run, to the public CloudFront URL.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=none;spacingTop=-4;" vertex="1" parent="1"><mxGeometry x="2777" y="86" width="560" height="80" as="geometry"/></mxCell><mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2725" y="178" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-2-desc-legend" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Reach the private load balancer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;CloudFront forwards through its VPC origin to the private ALB.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=none;spacingTop=-4;" vertex="1" parent="1"><mxGeometry x="2777" y="176" width="560" height="80" as="geometry"/></mxCell><mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2725" y="268" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-3-desc-legend" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Check the team login&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;The access pod checks the team password, removes it, and passes the request to identity.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=none;spacingTop=-4;" vertex="1" parent="1"><mxGeometry x="2777" y="266" width="560" height="80" as="geometry"/></mxCell><mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2725" y="358" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-4-desc-legend" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Route to the agent&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;identity sends /api/agent/agui to the Runtime, and other paths to the frontend and data services.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=none;spacingTop=-4;" vertex="1" parent="1"><mxGeometry x="2777" y="356" width="560" height="80" as="geometry"/></mxCell><mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2725" y="448" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-5-desc-legend" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Invoke the Runtime&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;identity signs with the EKS node role and streams the agent's events back to Chat. One session per chat thread.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=none;spacingTop=-4;" vertex="1" parent="1"><mxGeometry x="2777" y="446" width="560" height="80" as="geometry"/></mxCell><mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2725" y="538" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-6-desc-legend" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Plan and answer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;The Node Strands agent on AgentCore Runtime calls the Claude model on Amazon Bedrock.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=none;spacingTop=-4;" vertex="1" parent="1"><mxGeometry x="2777" y="536" width="560" height="80" as="geometry"/></mxCell><mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2725" y="628" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-7-desc-legend" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Query the knowledge graph&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;For disease questions, the agent calls the knowledge graph's AgentCore Gateway over signed MCP.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=none;spacingTop=-4;" vertex="1" parent="1"><mxGeometry x="2777" y="626" width="560" height="80" as="geometry"/></mxCell><mxCell id="step-8-badge-legend" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2725" y="718" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-8-desc-legend" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Run the graph tool&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;The Gateway invokes the kg-graph Lambda.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=none;spacingTop=-4;" vertex="1" parent="1"><mxGeometry x="2777" y="716" width="560" height="80" as="geometry"/></mxCell><mxCell id="step-9-badge-legend" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2725" y="808" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-9-desc-legend" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Read the graph&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;The Lambda runs read-only queries on Amazon Neptune, and returns evidence with citations.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=none;spacingTop=-4;" vertex="1" parent="1"><mxGeometry x="2777" y="806" width="560" height="80" as="geometry"/></mxCell><mxCell id="step-10-badge-legend" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2725" y="898" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-10-desc-legend" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Run Virtual Lab tools&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Survival, cohort, lollipop and OncoMatrix tools run inside the Runtime and call the data through the public URL with the team login.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=none;spacingTop=-4;" vertex="1" parent="1"><mxGeometry x="2777" y="896" width="560" height="80" as="geometry"/></mxCell><mxCell id="step-11-badge-legend" value="11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2725" y="988" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-11-desc-legend" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Reach the data&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;identity adds the sandbox token and routes to Gen3 Analysis, Guppy or ProteinPaint. Chat then draws the charts in the browser.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=none;spacingTop=-4;" vertex="1" parent="1"><mxGeometry x="2777" y="986" width="560" height="80" as="geometry"/></mxCell><mxCell id="step-12-badge-legend" value="12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2725" y="1078" width="40" height="38" as="geometry"/></mxCell><mxCell id="step-12-desc-legend" value="&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Refresh the graph&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;A daily schedule fetches source data to S3 and loads it into Neptune. The graph API reads the same graph.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=none;spacingTop=-4;" vertex="1" parent="1"><mxGeometry x="2777" y="1076" width="560" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
