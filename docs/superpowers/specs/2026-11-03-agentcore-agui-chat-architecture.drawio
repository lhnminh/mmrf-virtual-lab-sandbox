        <mxCell id="step-S" value="S" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="955" y="340" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-S2" value="S" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1300" y="340" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-B" value="B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D86613;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1020" y="444" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1050.0" y="378.0" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-C" value="C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D86613;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1370" y="444" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1390.0" y="288.0" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1700.0" y="290.0" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1700.0" y="338.0" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2040" y="335" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-11" value="11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="72" y="590" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="title-group" value="" style="group;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2520" height="83" as="geometry" /></mxCell>
        <mxCell id="title-text" value="AgentCore AG-UI Chat: Local Dev Server, Deployed Agent and Tools" style="text;html=1;resizable=1;points=[];autosize=0;align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="0" y="0" width="1500" height="42" as="geometry" /></mxCell>
        <mxCell id="subtitle-text" value="Chat runs on a local next dev server and streams AG-UI from an agent on AgentCore Runtime. Four Lambda tools reach the deployed Virtual Lab through CloudFront. Charts fetch their own data from the deployed services through a local forwarder. The cohort filter never reaches the model." style="text;html=1;resizable=0;points=[];autosize=0;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="5" y="40" width="2510" height="25" as="geometry" /></mxCell>
        <mxCell id="title-separator" value="" style="line;strokeWidth=2;html=1;fontSize=14;strokeColor=#FF9900;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="5" y="70" width="2510" height="10" as="geometry" /></mxCell>
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2620" y="30" width="640" height="1232" as="geometry" /></mxCell>
        <mxCell id="legend-title" value="Request flow (teal and purple) and cohort state path (orange A to E)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=light-dark(#232F3E,#E8E8E8);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2640" y="44" width="600" height="28" as="geometry" /></mxCell>
        <mxCell id="step-1-badge-legend" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="88" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-1-desc-legend" value="&lt;div&gt;&lt;b&gt;Browser to dev route&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;POST RunAgentInput. The browser holds no AWS credentials and no Virtual Lab login.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="84" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="144" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-2-desc-legend" value="&lt;div&gt;&lt;b&gt;Dev route to Runtime&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;InvokeAgentRuntime signed with SigV4 from local AWS credentials.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="140" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="200" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;Agent calls the model&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Bedrock, using the Runtime role.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="196" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="256" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-4-desc-legend" value="&lt;div&gt;&lt;b&gt;Agent to Gateway&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;MCP over HTTPS with SigV4. Gateway inbound auth is AWS_IAM.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="252" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="312" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-5-desc-legend" value="&lt;div&gt;&lt;b&gt;Gateway to Lambda&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;lambda:InvokeFunction. Four tools: check_virtual_lab_health, update_cohort, show_oncomatrix, show_lollipop.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="308" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="368" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-6-desc-legend" value="&lt;div&gt;&lt;b&gt;Lambda reads the login&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;GetSecretValue with the Lambda role.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="364" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="424" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-7-desc-legend" value="&lt;div&gt;&lt;b&gt;Lambda to the deployed Virtual Lab&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudFront with Basic auth. Guppy for GraphQL case counts; ProteinPaint for top genes, gene lookup and mutation tracks.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="420" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-8-badge-legend" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="480" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-8-desc-legend" value="&lt;div&gt;&lt;b&gt;Existing route&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudFront, internal ALB, access pod, identity gateway pod, then /guppy/ or /protein-paint/.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="476" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-9-badge-legend" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="536" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-9-desc-legend" value="&lt;div&gt;&lt;b&gt;SSE stream to dev route&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;AG-UI events stream during the run, including STATE_SNAPSHOT.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="532" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-10-badge-legend" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="592" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-10-desc-legend" value="&lt;div&gt;&lt;b&gt;SSE stream to browser&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The dev route relays each chunk unbuffered. AWS error text never reaches the page.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="588" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-11-badge-legend" value="11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="648" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-11-desc-legend" value="&lt;div&gt;&lt;b&gt;Chart data through dev-forward&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;OncoMatrix and Lollipop run in the browser and fetch their own data from the deployed services. dev-forward adds the Basic login.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="644" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-S-badge-legend" value="S" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="704" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-S-desc-legend" value="&lt;div&gt;&lt;b&gt;Setup, not per request&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Runtime reads the agent zip and Gateway reads the tool schema, both from the S3 code bucket.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="700" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-A-badge-legend" value="A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D86613;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="760" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-A-desc-legend" value="&lt;div&gt;&lt;b&gt;Cohort state in&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Browser sends state.cohort inside RunAgentInput (step 1).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="756" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-B-badge-legend" value="B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D86613;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="816" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-B-desc-legend" value="&lt;div&gt;&lt;b&gt;Hook adds the filter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;In Runtime, a hook adds cohortFilter to a copy of the tool call. The model's own copy has no filter.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="812" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-C-badge-legend" value="C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D86613;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="872" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-C-desc-legend" value="&lt;div&gt;&lt;b&gt;Filter reaches the tool&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The copy goes Gateway to Lambda with cohortFilter in the arguments.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="868" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-D-badge-legend" value="D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D86613;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="928" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-D-desc-legend" value="&lt;div&gt;&lt;b&gt;Hook strips the filter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The hook removes cohortFilter from the Lambda result before the model sees it.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="924" width="560" height="52" as="geometry" /></mxCell>
        <mxCell id="step-E-badge-legend" value="E" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D86613;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2640" y="984" width="40" height="36" as="geometry" /></mxCell>
        <mxCell id="step-E-desc-legend" value="&lt;div&gt;&lt;b&gt;STATE_SNAPSHOT to browser&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Runtime emits STATE_SNAPSHOT in the SSE stream (steps 9, 10) and the browser updates its cohort.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2692" y="980" width="560" height="52" as="geometry" /></mxCell>
