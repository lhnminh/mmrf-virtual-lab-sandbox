        <mxCell id="step-1-desc-legend" value='&lt;div&gt;&lt;b&gt;Browser to dev route&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;POST RunAgentInput. The browser holds no AWS credentials or Virtual Lab login.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2452" y="80" width="510" height="52" as="geometry"/></mxCell>
        <mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2400" y="136" width="40" height="36" as="geometry"/></mxCell>
        <mxCell id="step-2-desc-legend" value='&lt;div&gt;&lt;b&gt;Dev route to Runtime&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;InvokeAgentRuntime signed with SigV4 from the local AWS profile. Body unchanged; session ID is the SHA-256 of threadId.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2452" y="132" width="510" height="52" as="geometry"/></mxCell>
        <mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2400" y="188" width="40" height="36" as="geometry"/></mxCell>
        <mxCell id="step-3-desc-legend" value='&lt;div&gt;&lt;b&gt;Agent calls the model&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;Bedrock, using the Runtime role. The agent calls it again once the tool result is back.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2452" y="184" width="510" height="52" as="geometry"/></mxCell>
        <mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2400" y="240" width="40" height="36" as="geometry"/></mxCell>
        <mxCell id="step-4-desc-legend" value='&lt;div&gt;&lt;b&gt;Agent to Gateway&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;MCP over HTTPS, signed with SigV4 using the Runtime role. Gateway inbound auth is AWS_IAM.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2452" y="236" width="510" height="52" as="geometry"/></mxCell>
        <mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2400" y="292" width="40" height="36" as="geometry"/></mxCell>
        <mxCell id="step-5-desc-legend" value='&lt;div&gt;&lt;b&gt;Gateway to Lambda&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;lambda:InvokeFunction with the Gateway role. Tool appears as virtual-lab___check_virtual_lab_health.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2452" y="288" width="510" height="52" as="geometry"/></mxCell>
        <mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2400" y="344" width="40" height="36" as="geometry"/></mxCell>
        <mxCell id="step-6-desc-legend" value='&lt;div&gt;&lt;b&gt;Lambda reads the login&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;GetSecretValue with the Lambda role. Cached per Lambda instance.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2452" y="340" width="510" height="52" as="geometry"/></mxCell>
        <mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2400" y="396" width="40" height="36" as="geometry"/></mxCell>
        <mxCell id="step-7-desc-legend" value='&lt;div&gt;&lt;b&gt;Lambda to the public route&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;GET /sandbox/status over HTTPS with Basic auth, the same route a browser uses.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2452" y="392" width="510" height="52" as="geometry"/></mxCell>
        <mxCell id="step-8-badge-legend" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2400" y="448" width="40" height="36" as="geometry"/></mxCell>
        <mxCell id="step-8-desc-legend" value='&lt;div&gt;&lt;b&gt;Existing route to identity&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;CloudFront, internal ALB, access pod, identity pod. The result returns the same way to the agent.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2452" y="444" width="510" height="52" as="geometry"/></mxCell>
        <mxCell id="step-9-badge-legend" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2400" y="500" width="40" height="36" as="geometry"/></mxCell>
        <mxCell id="step-9-desc-legend" value='&lt;div&gt;&lt;b&gt;SSE stream to dev route&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;AG-UI events stream during the run, so the tool row appears before the answer finishes.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2452" y="496" width="510" height="52" as="geometry"/></mxCell>
        <mxCell id="step-10-badge-legend" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2400" y="552" width="40" height="36" as="geometry"/></mxCell>
        <mxCell id="step-10-desc-legend" value='&lt;div&gt;&lt;b&gt;SSE stream to browser&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;The dev route writes each chunk through unbuffered. AWS error text never reaches the browser.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2452" y="548" width="510" height="52" as="geometry"/></mxCell>
        <mxCell id="step-S-badge-legend" value="S" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2400" y="604" width="40" height="36" as="geometry"/></mxCell>
